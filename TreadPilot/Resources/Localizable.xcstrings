        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezetten ki van kapcsolva. Bármikor átvehető az irányítás a sebesség vagy a dőlés módosításával a konzolon — az irányítás ezután a szegmens hátralévő részében nálad marad."
          }
        }
      }
