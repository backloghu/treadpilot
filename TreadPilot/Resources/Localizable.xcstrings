    "Changing these values overrides the data read from Health. When heart rate data is available, calories are calculated from heart rate; otherwise the app uses a speed- and incline-based (MET) estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing these values overrides the data read from Health. When heart rate data is available, calories are calculated from heart rate; otherwise the app uses a speed- and incline-based (MET) estimate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értékek módosítása felülírja a Healthből olvasott adatokat. Ha van pulzusadat, a kalóriaszámítás pulzusalapú; egyébként sebesség- és dőlésalapú (MET) becslést használ az app."
          }
        }
      }
